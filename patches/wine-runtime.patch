+/* Opt-in private loader bookkeeping for compatibility experiments where
+ * application code replaces the public PEB loader-data pointer. */
+static unsigned int private_loader_data;
+static PEB_LDR_DATA *canonical_loader_data = &ldr;
+static NTSTATUS (WINAPI *gate_thread_start)(void);
+static NTSTATUS (WINAPI *gate_thread_finish)(void);
+static PEB_LDR_DATA *loader_data(void)
+{
+    PEB_LDR_DATA *public_data = NtCurrentTeb()->Peb->LdrData;
+    LIST_ENTRY *old_heads[3], *new_heads[3];
+    unsigned int i;
+
+    if (private_loader_data == 1) return &ldr;
+    if (private_loader_data != 2) return public_data;
+    if (public_data == canonical_loader_data) return public_data;
+    if (!public_data) return canonical_loader_data;
+
+    old_heads[0] = &canonical_loader_data->InLoadOrderModuleList;
+    old_heads[1] = &canonical_loader_data->InMemoryOrderModuleList;
+    old_heads[2] = &canonical_loader_data->InInitializationOrderModuleList;
+    new_heads[0] = &public_data->InLoadOrderModuleList;
+    new_heads[1] = &public_data->InMemoryOrderModuleList;
+    new_heads[2] = &public_data->InInitializationOrderModuleList;
+    /* Loader callers hold loader_section. Validate every shallow-copied
+     * head before changing any links; unrelated replacement lists stay
+     * untouched and the existing canonical bookkeeping remains usable. */
+    for (i = 0; i < 3; ++i)
+    {
+        LIST_ENTRY *old = old_heads[i], *copy = new_heads[i];
+        if (!old->Flink || !old->Blink || copy->Flink != old->Flink || copy->Blink != old->Blink ||
+            old->Flink->Blink != old || old->Blink->Flink != old)
+            return canonical_loader_data;
+    }
+    for (i = 0; i < 3; ++i)
+    {
+        LIST_ENTRY *old = old_heads[i], *copy = new_heads[i];
+        if (old->Flink == old) InitializeListHead( copy );
+        else
+        {
+            copy->Flink->Blink = copy;
+            copy->Blink->Flink = copy;
+        }
+    }
+    canonical_loader_data = public_data;
+    TRACE_(loaddll)( "validated canonical public loader lists at %p\n", public_data );
+    return public_data;
+}
 
