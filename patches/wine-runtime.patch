 static struct heap *process_heap;  /* main process heap */
 
+/* Publish the real process heap list for clients reading the Windows PEB.
+ * Called under process_heap->cs after the main heap has been initialized.
+ * Old grown tables stay mapped until exit so readers cannot use freed storage. */
+static HANDLE DECLSPEC_ALIGN(4096) initial_process_heaps[512];
+static HANDLE *peb_process_heaps = initial_process_heaps;
+static ULONG peb_heap_capacity = ARRAY_SIZE(initial_process_heaps);
+
+static BOOL update_peb_process_heaps(void)
+{
+    PEB *peb = NtCurrentTeb()->Peb;
+    struct list *ptr;
+    ULONG total = 1, i = 1;
+    HANDLE *table = peb_process_heaps;
+
+    LIST_FOR_EACH(ptr, &process_heap->entry) total++;
+    if (total > peb_heap_capacity)
+    {
+        ULONG capacity = peb_heap_capacity;
+        SIZE_T size;
+        while (capacity < total)
+        {
+            if (capacity > ~0u / 2) return FALSE;
+            capacity *= 2;
+        }
+        size = (SIZE_T)capacity * sizeof(*table);
+        table = NULL;
+        if (NtAllocateVirtualMemory(NtCurrentProcess(), (void **)&table, 0, &size,
+                                    MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE)) return FALSE;
+        peb_process_heaps = table;
+        peb_heap_capacity = capacity;
+    }
+    table[0] = process_heap;
+    LIST_FOR_EACH(ptr, &process_heap->entry)
+        table[i++] = LIST_ENTRY(ptr, struct heap, entry);
+    InterlockedExchangePointer((void **)&peb->ProcessHeaps, table);
+    peb->MaximumNumberOfHeaps = peb_heap_capacity;
+    peb->NumberOfHeaps = total;
+    return TRUE;
+}
