+/* Experimental host-side active-poll budget; zero preserves the original policy. */
+static uint64_t
+vkr_ring_spin_budget_ns(void)
+{
+   const char *value = getenv("LEGION_VENUS_RING_SPIN_US");
+   if (!value || !*value)
+      return 0;
+
+   char *end;
+   errno = 0;
+   const unsigned long us = strtoul(value, &end, 10);
+   if (errno || *end || us > 200)
+      return 0;
+   return us * 1000;
+}
+
+static inline void
+vkr_ring_cpu_relax(void)
+{
+#if defined(__i386__) || defined(__x86_64__)
+   __builtin_ia32_pause();
+#elif defined(__aarch64__)
+   __asm__ __volatile__("yield");
+#else
+   atomic_signal_fence(memory_order_seq_cst);
+#endif
+}
+
+static void
+vkr_ring_relax(uint32_t *iter, bool measure,
