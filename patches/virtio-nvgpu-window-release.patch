 //! Unit tests for the backend. Those that need /dev/nvidiactl skip without it.
 
 use super::*;
+
+#[cfg(test)]
+mod transport_release_tests {
+    use super::*;
+    use std::sync::{Arc, Mutex};
+
+    struct Window {
+        calls: Arc<Mutex<Vec<(u64, u64)>>>,
+        fail: bool,
+    }
+
+    impl crate::shm::WindowPlacer for Window {
+        fn place(&self, _: u64, _: u64, _: RawFd, _: u64, _: bool) -> Result<()> {
+            Ok(())
+        }
+
+        fn withdraw(&self, offset: u64, len: u64) -> Result<()> {
+            self.calls.lock().expect("test window lock").push((offset, len));
+            if self.fail {
+                return Err(std::io::Error::other("test transport failure").into());
+            }
+            Ok(())
+        }
+    }
+
+    #[test]
+    fn transport_release_notifies_vmm_before_reusing_an_extent() {
+        let mut backend = NvidiaBackend::for_test();
+        let before = backend.shm_free_bytes();
+        let calls = Arc::new(Mutex::new(Vec::new()));
+        backend.set_window(Box::new(Window { calls: calls.clone(), fail: false }));
+        let region = backend.shm.alloc(4096, crate::shm::PgprotKind::WriteCombine).expect("allocate test region");
+        backend.release_mapped_region(&region).expect("release mapping");
+        assert_eq!(*calls.lock().expect("test window lock"), [(region.offset, region.length)]);
+        assert_eq!(backend.shm_free_bytes(), before);
+        let reused = backend.shm.alloc(4096, crate::shm::PgprotKind::WriteCombine).expect("reuse test region");
+        assert_eq!(reused.offset, region.offset);
+    }
+
+    #[test]
+    fn transport_release_failure_keeps_the_extent_reserved() {
+        let mut backend = NvidiaBackend::for_test();
+        backend.set_window(Box::new(Window { calls: Arc::new(Mutex::new(Vec::new())), fail: true }));
+        let region = backend.shm.alloc(4096, crate::shm::PgprotKind::WriteCombine).expect("allocate test region");
+        let reserved = backend.shm_free_bytes();
+        assert!(backend.release_mapped_region(&region).is_err());
+        assert_eq!(backend.shm_free_bytes(), reserved);
+        let next = backend.shm.alloc(4096, crate::shm::PgprotKind::WriteCombine).expect("allocate another region");
+        assert_ne!(next.offset, region.offset);
+    }
+}
 
