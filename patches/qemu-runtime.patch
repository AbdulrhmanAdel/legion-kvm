+++ b/hw/virtio/legion-fixed-shmem.c.inc
@@ -0,0 +1,228 @@
+/* Isolated Linux/KVM research mode, explicitly selected by environment.
+ * The host aperture is owned in full. Holes are inaccessible, rather than
+ * emulated as unassigned PCI space. This is not a general runtime default.
+ * Called under QEMU's BQL, with the existing non-overlap/range admission.
+ */
+#include <linux/kvm.h>
+#include "system/kvm.h"
+#include "qemu/range.h"
+
+static uint64_t legion_fixed_maps, legion_fixed_withdrawals, legion_fixed_fallbacks;
+static bool legion_fixed_diagnostic;
+
+static void legion_fixed_observe(const char *operation, gint64 start, uint64_t bytes)
+{
+    static unsigned records;
+    if (!legion_fixed_diagnostic) {
+        return;
+    }
+    if (records++ < 8192) {
+        fprintf(stderr, "LEGION_FIXED_VIEW operation=%s bytes=%" PRIu64
+                " duration_us=%" G_GINT64_FORMAT "\n", operation, bytes,
+                g_get_monotonic_time() - start);
+    } else if (records == 8193) {
+        fprintf(stderr, "LEGION_FIXED_VIEW truncated=1\n");
+    }
+}
+
+static void legion_fixed_totals(void)
+{
+    fprintf(stderr, "LEGION_FIXED_SHMEM totals maps=%" PRIu64
+            " withdrawals=%" PRIu64 " readonly_fallbacks=%" PRIu64 "\n",
+            legion_fixed_maps, legion_fixed_withdrawals, legion_fixed_fallbacks);
+}
+
+static void legion_fixed_hole(void *address, uint64_t length)
+{
+    void *result = mmap(address, length, PROT_NONE,
+                        MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0);
+    if (result != address) {
+        /* Never acknowledge removal while an old GPU view can remain live. */
+        error_report("fixed shmem: cannot restore inaccessible hole: %s",
+                     strerror(errno));
+        exit(EXIT_FAILURE);
+    }
+}
+
+static void legion_fixed_init(VirtioSharedMemory *shmem, uint64_t size)
+{
+    const char *enabled = getenv("LEGION_FIXED_SHMEM");
+    g_autofree char *name = NULL;
+    VirtioSharedMemoryMapping *owner;
+    MemoryRegion *mr;
+
+    if (!enabled || !strcmp(enabled, "0") || !strcmp(enabled, "off")) {
+        return;
+    }
+    bool automatic = !strcmp(enabled, "auto");
+    if (!automatic && strcmp(enabled, "1") && strcmp(enabled, "required")) {
+        error_report("fixed shmem: expected off, auto or required");
+        exit(EXIT_FAILURE);
+    }
+    /* QEMU probes this KVM capability during accelerator initialization. */
+    if (!kvm_enabled() || !kvm_state || !kvm_has_sync_mmu()) {
+        error_report("fixed shmem: KVM synchronous MMU support unavailable%s",
+                     automatic ? "; using dynamic mappings" : "");
+        if (automatic) {
+            return;
+        }
+        exit(EXIT_FAILURE);
+    }
+    const char *diagnostic = getenv("LEGION_FIXED_SHMEM_DIAG");
+    legion_fixed_diagnostic = diagnostic && !strcmp(diagnostic, "1");
+    static bool registered;
+    if (!registered) {
+        if (atexit(legion_fixed_totals)) {
+            error_report("fixed shmem: cannot register final counters");
+            exit(EXIT_FAILURE);
+        }
+        registered = true;
+    }
+    if (!size || size > SIZE_MAX || size % qemu_real_host_page_size()) {
+        error_report("fixed shmem: unsupported aperture size");
+        if (automatic) {
+            return;
+        }
+        exit(EXIT_FAILURE);
+    }
+    shmem->fixed_base = mmap(NULL, size, PROT_NONE,
+                             MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (shmem->fixed_base == MAP_FAILED) {
+        error_report("fixed shmem: cannot reserve aperture: %s", strerror(errno));
+        shmem->fixed_base = NULL;
+        if (automatic) {
+            return;
+        }
+        exit(EXIT_FAILURE);
+    }
+    /* Use the same owner type as dynamic mappings so the existing vhost
+     * memory listener excludes the whole device aperture from guest RAM.
+     */
+    owner = VIRTIO_SHARED_MEMORY_MAPPING(object_new(TYPE_VIRTIO_SHARED_MEMORY_MAPPING));
+    mr = g_new0(MemoryRegion, 1);
+    name = g_strdup_printf("virtio-fixed-shmem-%d", shmem->shmid);
+    memory_region_init_ram_device_ptr(mr, OBJECT(owner), name, size, shmem->fixed_base);
+    owner->mr = mr;
+    owner->len = size;
+    shmem->fixed_owner = owner;
+    memory_region_add_subregion(&shmem->mr, 0, mr);
+    fprintf(stderr, "LEGION_FIXED_SHMEM window=%u bytes=%" PRIu64 "\n", shmem->shmid, size);
+}
+
+static bool legion_fixed_admit(VirtioSharedMemory *shmem, uint64_t offset,
+                               uint64_t length, uint64_t fd_offset)
+{
+    VirtioSharedMemoryMapping *view;
+    uint64_t size = memory_region_size(&shmem->mr);
+    if (!length || offset > size || length > size - offset ||
+        fd_offset > INT64_MAX || length > INT64_MAX - fd_offset) {
+        error_report("fixed shmem: invalid view range");
+        return false;
+    }
+    QTAILQ_FOREACH(view, &shmem->mmaps, link) {
+        if (ranges_overlap(view->offset, view->len, offset, length)) {
+            error_report("fixed shmem: live view overlap");
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool legion_fixed_aligned(uint64_t offset, uint64_t length, uint64_t fd_offset)
+{
+    size_t page = qemu_real_host_page_size();
+    return !(offset % page) && !(length % page) && !(fd_offset % page);
+}
+
+static VirtioSharedMemoryMapping *legion_fixed_mapping(
+        VirtioSharedMemory *shmem, int fd, uint64_t fd_offset,
+        uint64_t offset, uint64_t length)
+{
+    const size_t page = qemu_real_host_page_size();
+    VirtioSharedMemoryMapping *mapping;
+    void *address, *result;
+    int owned_fd;
+    gint64 start = legion_fixed_diagnostic ? g_get_monotonic_time() : 0;
+
+    if (!length || offset > memory_region_size(&shmem->mr) ||
+        length > memory_region_size(&shmem->mr) - offset ||
+        (offset % page) || (length % page) || (fd_offset % page) ||
+        fd_offset > INT64_MAX || length > INT64_MAX - fd_offset) {
+        error_report("fixed shmem: invalid aligned range or fd offset");
+        return NULL;
+    }
+    owned_fd = fcntl(fd, F_DUPFD_CLOEXEC, 0);
+    if (owned_fd < 0) {
+        error_report("fixed shmem: cannot duplicate backing fd: %s", strerror(errno));
+        return NULL;
+    }
+    address = (char *)shmem->fixed_base + offset;
+    result = mmap(address, length, PROT_READ | PROT_WRITE,
+                  MAP_SHARED | MAP_FIXED, owned_fd, fd_offset);
+    if (result != address) {
+        int saved_errno = errno;
+        /* A driver's failed mmap may already have removed the reservation. */
+        legion_fixed_hole(address, length);
+        close(owned_fd);
+        error_report("fixed shmem: backing mmap failed: %s", strerror(saved_errno));
+        return NULL;
+    }
+    mapping = VIRTIO_SHARED_MEMORY_MAPPING(object_new(TYPE_VIRTIO_SHARED_MEMORY_MAPPING));
+    mapping->shmid = shmem->shmid;
+    mapping->offset = offset;
+    mapping->len = length;
+    mapping->fixed_address = address;
+    mapping->fixed_fd = owned_fd;
+    shmem->fixed_maps++;
+    legion_fixed_maps++;
+    if (shmem->fixed_maps == 1) {
+        fprintf(stderr, "LEGION_FIXED_SHMEM active window=%u\n", shmem->shmid);
+    }
+    legion_fixed_observe("map", start, length);
+    return mapping;
+}
+
+static void legion_fixed_release(VirtioSharedMemoryMapping *mapping)
+{
+    gint64 start = legion_fixed_diagnostic ? g_get_monotonic_time() : 0;
+    bool observed = mapping->fixed_address != NULL;
+    if (mapping->fixed_address) {
+        legion_fixed_hole(mapping->fixed_address, mapping->len);
+        mapping->fixed_address = NULL;
+        legion_fixed_withdrawals++;
+    }
+    if (mapping->fixed_fd >= 0) {
+        close(mapping->fixed_fd);
+        mapping->fixed_fd = -1;
+    }
+    if (observed) {
+        legion_fixed_observe("unmap", start, mapping->len);
+    }
+}
+
+static void legion_fixed_destroy(VirtioSharedMemory *shmem)
+{
+    if (!shmem->fixed_base) {
+        return;
+    }
+    assert(QTAILQ_EMPTY(&shmem->mmaps));
+    memory_region_del_subregion(&shmem->mr, shmem->fixed_owner->mr);
+    object_unref(OBJECT(shmem->fixed_owner));
+    if (munmap(shmem->fixed_base, memory_region_size(&shmem->mr))) {
+        error_report("fixed shmem: aperture teardown failed: %s", strerror(errno));
+        exit(EXIT_FAILURE);
+    }
+    shmem->fixed_base = NULL;
+    shmem->fixed_owner = NULL;
+    fprintf(stderr, "LEGION_FIXED_SHMEM done window=%u maps=%" PRIu64
+            " unmaps=%" PRIu64 " fallback=%" PRIu64 "\n",
+            shmem->shmid, shmem->fixed_maps, shmem->fixed_unmaps, shmem->fixed_fallback);
+}
+
+static void legion_shmem_clear(VirtioSharedMemory *shmem)
+{
+    while (!QTAILQ_EMPTY(&shmem->mmaps)) {
+        VirtioSharedMemoryMapping *view = QTAILQ_FIRST(&shmem->mmaps);
+        virtio_del_shmem_map(shmem, view->offset, view->len);
+    }
+}
--- /dev/null
+++ b/hw/virtio/legion-fixed-shmem-selftest.c.inc
@@ -0,0 +1,136 @@
+/* Explicit lifecycle fixture using the real QEMU mapping implementation.
+ * Runs before the window is advertised, with only owned memfds. Never runs
+ * during performance measurements. Does not inject GPU memory or outcomes.
+ */
+#include <sys/uio.h>
+
+static void legion_fixed_expect(bool condition, const char *label)
+{
+    if (!condition) {
+        error_report("LEGION_FIXED_SELFTEST failed=%s", label);
+        exit(EXIT_FAILURE);
+    }
+}
+
+static int legion_fixed_source(size_t length, unsigned char tag)
+{
+    int fd = memfd_create("legion-fixed-lifecycle", MFD_CLOEXEC);
+    legion_fixed_expect(fd >= 0, "memfd_create");
+    legion_fixed_expect(ftruncate(fd, length) == 0, "ftruncate");
+    void *data = mmap(NULL, length, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    legion_fixed_expect(data != MAP_FAILED, "initialize_mmap");
+    memset(data, tag, length);
+    legion_fixed_expect(munmap(data, length) == 0, "initialize_munmap");
+    return fd;
+}
+
+static void legion_fixed_expect_hole(void *address)
+{
+    unsigned char byte;
+    struct iovec local = { .iov_base = &byte, .iov_len = 1 };
+    struct iovec remote = { .iov_base = address, .iov_len = 1 };
+    /* A bounded read of our own address space checks PROT_NONE without
+     * deliberately faulting a QEMU thread or changing signal handlers.
+     */
+    errno = 0;
+    ssize_t result = process_vm_readv(getpid(), &local, 1, &remote, 1, 0);
+    legion_fixed_expect(result == -1 && errno == EFAULT, "inaccessible_hole");
+}
+
+static void legion_fixed_selftest(VirtioSharedMemory *shmem)
+{
+    const char *enabled = getenv("LEGION_FIXED_SHMEM_SELFTEST");
+    if (!enabled || strcmp(enabled, "1")) {
+        return;
+    }
+    legion_fixed_expect(shmem->fixed_base != NULL, "fixed_window_required");
+    size_t page = qemu_real_host_page_size();
+    uint64_t size = memory_region_size(&shmem->mr);
+    legion_fixed_expect(size >= page * 3 && QTAILQ_EMPTY(&shmem->mmaps), "empty_window");
+    legion_fixed_expect_hole(shmem->fixed_base);
+
+    int fd = legion_fixed_source(page * 3, 0x3c);
+    VirtioSharedMemoryMapping *view = virtio_shared_memory_mapping_new(
+        shmem, shmem->shmid, fd, 0, 0, page, true);
+    legion_fixed_expect(view && view->fixed_address, "writable_map");
+    legion_fixed_expect(virtio_add_shmem_map(shmem, view) == 0, "add_writable_map");
+    int owned_fd = view->fixed_fd;
+    int fd_flags = fcntl(owned_fd, F_GETFD);
+    legion_fixed_expect(fd_flags >= 0 && (fd_flags & FD_CLOEXEC), "owned_cloexec");
+    close(fd);
+    legion_fixed_expect(((unsigned char *)view->fixed_address)[page - 1] == 0x3c,
+                        "original_fd_close_preserves_view");
+
+    fd = legion_fixed_source(page * 3, 0xa7);
+    VirtioSharedMemoryMapping *bad = virtio_shared_memory_mapping_new(
+        shmem, shmem->shmid, fd, 0, 0, page, true);
+    legion_fixed_expect(!bad, "reject_overlap_before_replacement");
+    legion_fixed_expect(((unsigned char *)view->fixed_address)[0] == 0x3c,
+                        "overlap_preserves_old_contents");
+    legion_fixed_expect(virtio_add_shmem_map(shmem, view) != 0, "reject_double_link");
+    for (unsigned i = 0; i < 4; i++) {
+        uint64_t offset = i == 0 ? size : i == 1 ? UINT64_MAX : page;
+        uint64_t length = i == 2 ? 0 : page;
+        uint64_t file_offset = i == 3 ? UINT64_MAX : 0;
+        bad = virtio_shared_memory_mapping_new(shmem, shmem->shmid, fd,
+                                              file_offset, offset, length, true);
+        legion_fixed_expect(!bad, "reject_invalid_range");
+    }
+    virtio_del_shmem_map(shmem, 0, page);
+    errno = 0;
+    legion_fixed_expect(fcntl(owned_fd, F_GETFD) == -1 && errno == EBADF, "close_owned_fd");
+    legion_fixed_expect_hole(shmem->fixed_base);
+    virtio_del_shmem_map(shmem, 0, page); /* Repeated withdrawal is harmless. */
+
+    bad = virtio_shared_memory_mapping_new(shmem, shmem->shmid, -1, 0, 0, page, true);
+    legion_fixed_expect(!bad, "reject_bad_fd");
+    int nonmappable = open("/dev/null", O_RDONLY | O_CLOEXEC);
+    legion_fixed_expect(nonmappable >= 0, "open_nonmappable_fd");
+    bad = virtio_shared_memory_mapping_new(shmem, shmem->shmid, nonmappable, 0, 0, page, true);
+    legion_fixed_expect(!bad, "failed_mmap_rejected");
+    close(nonmappable);
+    legion_fixed_expect_hole(shmem->fixed_base);
+
+    /* Reusing a withdrawn or failed range must expose only its new backing. */
+    view = virtio_shared_memory_mapping_new(shmem, shmem->shmid, fd, 0, 0, page, true);
+    legion_fixed_expect(view && ((unsigned char *)view->fixed_address)[0] == 0xa7,
+                        "reused_range_has_new_contents");
+    object_unref(OBJECT(view)); /* Creation without insertion also cleans up. */
+    legion_fixed_expect_hole(shmem->fixed_base);
+
+    view = virtio_shared_memory_mapping_new(shmem, shmem->shmid, fd, 0, 0, page, true);
+    legion_fixed_expect(view && virtio_add_shmem_map(shmem, view) == 0, "reset_rw_view");
+    owned_fd = view->fixed_fd;
+    VirtioSharedMemoryMapping *readonly = virtio_shared_memory_mapping_new(
+        shmem, shmem->shmid, fd, page, page, page, false);
+    legion_fixed_expect(readonly && readonly->mr && !readonly->fixed_address &&
+                        memory_region_is_rom(readonly->mr),
+                        "readonly_uses_dynamic_overlay");
+    legion_fixed_expect(virtio_add_shmem_map(shmem, readonly) == 0, "add_readonly_view");
+    unsigned char *data = memory_region_get_ram_ptr(readonly->mr);
+    legion_fixed_expect(data[page - 1] == 0xa7, "readonly_contents");
+    unsigned char byte = 0;
+    struct iovec local = { .iov_base = &byte, .iov_len = 1 };
+    struct iovec remote = { .iov_base = data, .iov_len = 1 };
+    errno = 0;
+    ssize_t result = process_vm_writev(getpid(), &local, 1, &remote, 1, 0);
+    legion_fixed_expect(result == -1 && errno == EFAULT, "readonly_host_write_rejected");
+    close(fd);
+    legion_shmem_clear(shmem); /* Same routine as real reset and finalization. */
+    legion_fixed_expect(QTAILQ_EMPTY(&shmem->mmaps), "reset_drains_views");
+    errno = 0;
+    legion_fixed_expect(fcntl(owned_fd, F_GETFD) == -1 && errno == EBADF, "reset_closes_fd");
+    legion_fixed_expect_hole(shmem->fixed_base);
+    legion_fixed_expect_hole((char *)shmem->fixed_base + page);
+    void *retired = shmem->fixed_base;
+    legion_fixed_destroy(shmem);
+    legion_fixed_expect(!shmem->fixed_base && !shmem->fixed_owner, "teardown_clears_owner");
+    unsigned char residency;
+    errno = 0;
+    legion_fixed_expect(mincore(retired, page, &residency) == -1 && errno == ENOMEM,
+                        "teardown_unmaps_aperture");
+    legion_fixed_init(shmem, size);
+    legion_fixed_expect(shmem->fixed_base != NULL, "reinitialize_after_teardown");
+    legion_fixed_expect_hole(shmem->fixed_base);
+    fprintf(stderr, "LEGION_FIXED_SELFTEST passed window=%u\n", shmem->shmid);
+}
