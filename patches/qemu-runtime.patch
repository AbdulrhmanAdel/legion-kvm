+++ b/accel/kvm/legion-fixed-slot-observer.c.inc
@@ -0,0 +1,24 @@
+/* Opt-in slot-ioctl diagnostic. No arguments or return values are changed. */
+static int legion_observed_memory_region(KVMState *s, int request,
+                                        struct kvm_userspace_memory_region2 *mem)
+{
+    static int enabled = -1;
+    static unsigned records;
+    int ret = kvm_vm_ioctl(s, request, mem);
+    int saved_errno = errno;
+    if (enabled < 0) {
+        const char *value = getenv("LEGION_FIXED_SHMEM_DIAG");
+        enabled = value && !strcmp(value, "1");
+    }
+    if (enabled) {
+        if (records++ < 8192) {
+            fprintf(stderr, "LEGION_FIXED_SLOT slot=%u gpa=%" PRIu64
+                    " bytes=%" PRIu64 " result=%d\n", mem->slot,
+                    (uint64_t)mem->guest_phys_addr, (uint64_t)mem->memory_size, ret);
+        } else if (records == 8193) {
+            fprintf(stderr, "LEGION_FIXED_SLOT truncated=1\n");
+        }
+    }
+    errno = saved_errno;
+    return ret;
+}
