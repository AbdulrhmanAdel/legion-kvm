+fn fence_ready(nvidia: &Arc<Mutex<NvidiaBackend>>, vring: &VringRwLock,
+               mem: &GuestMemoryAtomic<GuestMemoryMmap>, key: u64) -> bool {
+    let token = key & !FENCE_EVENT_KEY;
+    let packet = nvidia.lock().expect("backend mutex").begin_legion_fence_event(token);
+    if let Some(packet) = packet {
+        let accepted = push_event_data(vring, mem, &packet, true);
+        // CLOSE may run between queue publication and this receipt. Never
+        // hold the backend lock while accessing the event virtqueue.
+        nvidia.lock().expect("backend mutex").finish_legion_fence_event(token, accepted);
+        return accepted;
+    }
+    nvidia.lock().expect("backend mutex").legion_fence_watch_finished(token)
+}
