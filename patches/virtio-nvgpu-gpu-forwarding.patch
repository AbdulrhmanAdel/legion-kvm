+/* Private, pointer-free display control; never forwarded to a host ioctl. */
+struct nvgpu_legion_register {
+  __u32 handle, width, height, fourcc;
+  __u64 modifier;
+  __u32 stride, offset;
+  __u64 resource;
+  __u32 client, pad;
+};
+
+static long nvgpu_legion_display_ioctl(struct nvgpu_fd *nfd,
+                                       struct drm_file *file,
+                                       unsigned int cmd, unsigned long arg) {
+  unsigned int size;
+  u32 owner = nfd->handle, saved_handle = 0;
+  void *data;
+  long ret;
+  BUILD_BUG_ON(sizeof(struct nvgpu_legion_register) != 48);
+  switch (_IOC_NR(cmd)) {
+  case 1: size = 4112; break;
+  case 2: size = 48; break;
+  case 3: size = 16; break;
+  case 4: size = 264; break;
+  case 5: size = 8; break;
+  case 6: size = 40; break;
+  default: return -ENOTTY;
+  }
+  if (_IOC_SIZE(cmd) != size || _IOC_DIR(cmd) != (_IOC_READ | _IOC_WRITE))
+    return -EINVAL;
+  data = memdup_user((void __user *)arg, size);
+  if (IS_ERR(data))
+    return PTR_ERR(data);
+  if (_IOC_NR(cmd) == 2) {
+    struct nvgpu_legion_register *p = data;
+    u32 host;
+    saved_handle = p->handle;
+    ret = nvgpu_gem_to_host(file, p->handle, &host, &owner);
+    if (ret)
+      goto out;
+    p->handle = host;
+    p->client = nfd->handle;
+  }
+  ret = nvgpu_ioctl_flat_h(nfd->dev, owner, cmd, data, size);
+  if (_IOC_NR(cmd) == 2) {
+    struct nvgpu_legion_register *p = data;
+    p->handle = saved_handle;
+    p->client = 0;
+  }
+  if (!ret && copy_to_user((void __user *)arg, data, size))
+    ret = -EFAULT;
+out:
+  kfree(data);
+  return ret;
+}
